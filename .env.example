# Copy to .env and adjust. Only the four BONEHUB_DATASET_SHARE / BONEHUB_SMB_* values
# below are required. Never commit the filled-in .env -- it holds a password.

# ---------------------------------------------------------------- dataset location
# UNC path of the folder already in BoneHub data structure format (the folder that
# contains Dataset_001, Dataset_002, ...), with forward slashes and no trailing slash.
# Use the UNC path, NOT a Windows drive letter: Docker Desktop cannot bind-mount a
# mapped network drive and silently mounts an empty folder instead.
#   Z:/BoneHub/BoneHub_Dataset  ->  //192.168.0.10/Data/BoneHub/BoneHub_Dataset
# `net use` prints the UNC path behind each mapped drive letter.
BONEHUB_DATASET_SHARE=//192.168.0.10/Data/BoneHub/BoneHub_Dataset

# Credentials for that share.
#   - a password containing a comma cannot be used: the comma ends the option
#   - a literal $ must be written as $$ (docker compose expands single $)
BONEHUB_SMB_USERNAME=
BONEHUB_SMB_PASSWORD=

# Extra mount options, comma-separated. Add the domain if the share needs one, e.g.
# "domain=AD,vers=3.0". Lower vers only if the file server is old (3.0 -> 2.1 -> 1.0).
BONEHUB_SMB_OPTIONS=vers=3.0

# ---------------------------------------------------------------------- server
# Host port the server is published on.
BONEHUB_QC_PORT=8000

# Leave blank to let the server generate them on first start and store them in
# <dataset>/.bonehub_qc/. Set them to keep stable keys across recreated state folders.
# Changing BONEHUB_QC_PRIVATE_KEY invalidates every reviewer API key already issued.
BONEHUB_QC_ADMIN_KEY=
BONEHUB_QC_PRIVATE_KEY=

# Restrict the server to specific datasets: comma-separated dataset ids, e.g. "10" or
# "10,12". Leave blank for every Dataset_XXX under the root. Because the effective config
# is written back to <dataset>/.bonehub_qc/config.json on each start, blanking this later
# does NOT undo it -- set it to "none" to go back to all datasets.
BONEHUB_QC_ALLOWED_DATASET_IDS=

# Which subjects enter the queue: comma-separated Subject_info availability values.
#   -1 not available, not confirmed        0 not available, confirmed
#    1 available, from original source     2 available, auto-generated, no quality check
#    3 available, auto-generated, passed quality check
BONEHUB_QC_ELIGIBLE_LABEL_VALUES=2

# How long a reviewer keeps a subject before it returns to the queue.
BONEHUB_QC_LEASE_TTL_SECONDS=86400

# How many subjects one reviewer may hold at a time.
BONEHUB_QC_MAX_CONCURRENT_ASSIGNMENTS_PER_USER=1
