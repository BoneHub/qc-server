# Copy to .env and adjust. Only the dataset location below is required. Never commit the
# filled-in .env -- for a share it holds a password.

# ---------------------------------------------------------------- dataset location
# The folder already in BoneHub data structure format (the folder that contains
# Dataset_001, Dataset_002, ...). Fill in ONE of (a) and (b) and leave the other blank; a
# filled-in BONEHUB_DATASET_PATH wins. After switching between them, see "Where the server
# keeps things" in the README: the server's state lives in the dataset folder.

# (a) A folder on a disk of this computer, e.g. C:/data/BoneHub_Dataset or
#     /srv/BoneHub_Dataset. NOT a mapped network drive (Z:/...): Docker Desktop cannot
#     bind-mount one and silently mounts an empty folder instead. Use (b) for that.
BONEHUB_DATASET_PATH=

# (b) A folder on an SMB share, as a UNC path with forward slashes and no trailing slash.
#       Z:/BoneHub/BoneHub_Dataset  ->  //192.168.0.10/Data/BoneHub/BoneHub_Dataset
#     `net use` prints the UNC path behind each mapped drive letter.
BONEHUB_DATASET_SHARE=

#     Credentials for that share, required with it.
#       - a password containing a comma cannot be used: the comma ends the option
#       - a literal $ must be written as $$ (docker compose expands single $)
BONEHUB_SMB_USERNAME=
BONEHUB_SMB_PASSWORD=

#     Extra mount options, comma-separated. Add the domain if the share needs one, e.g.
#     "domain=AD,vers=3.0". Lower vers only if the file server is old (3.0 -> 2.1 -> 1.0).
BONEHUB_SMB_OPTIONS=vers=3.0

# ---------------------------------------------------------------------- server
# The server's name on this computer. Its container and volumes are named after it, e.g.
# its credentials volume <name>_credentials. Blank is bonehub_qc. Another server on this
# computer, on another dataset or on the same one, runs from a copy of this folder whose .env
# gives it a name of its own here, e.g. bonehub_qc_2, and a port of its own below. A copy
# left at the same name takes over the first server. Renaming a server that has already run
# starts a new server, with a new admin key and no users.
COMPOSE_PROJECT_NAME=

# Host port the server is published on.
BONEHUB_QC_PORT=8000

# Time zone of the server's logs (server.log, Dataset_XXX_qualitycheck.log), as an IANA
# name, e.g. Europe/Amsterdam. The container does not follow this computer's time zone.
# Blank is UTC. submissions.jsonl always records UTC.
BONEHUB_QC_TIMEZONE=

# Leave blank to let the server generate them on first start. They are kept inside the
# container, in the <name>_credentials volume on this Docker host -- never on the share
# -- and a generated admin key is printed once, at that first start. Lost it? Print it
# again with:
#     docker compose exec bonehub-qc-server bonehub-qc-server show-admin-key
# or start a new server (docker compose down -v && docker compose up -d), which issues a
# new admin key; users then need new keys too.
# Changing BONEHUB_QC_PRIVATE_KEY invalidates every API key already issued.
BONEHUB_QC_ADMIN_KEY=
BONEHUB_QC_PRIVATE_KEY=

# ---------------------------------------------------------------------- policy
# Leave these blank to set them in the admin panel (Policy); the server starts from the
# defaults given below. A value filled in here wins over the admin panel at every start, so
# a change made in the panel is undone by the next restart.

# Restrict the server to specific datasets: comma-separated dataset ids, e.g. "10" or
# "10,12". Leave blank for every Dataset_XXX under the root. Because the effective config
# is written back to <dataset>/.bonehub_qc/<server id>/config.json on each start, blanking this later
# does NOT undo it -- set it to "none" to go back to all datasets.
BONEHUB_QC_ALLOWED_DATASET_IDS=

# Which subjects enter the queue: comma-separated Subject_info label statuses. A subject
# is queued when one of its segmentation labels has one of them.
#    1 available, not reviewed or corrected
#    2 available, reviewed and corrected (add it to review reviewed subjects again)
# (0, not available, has no segmentation to review.) Approved labels are set to 2.
# Default: 1.
BONEHUB_QC_ELIGIBLE_LABEL_VALUES=

# Whether the labels an editor corrected go back to a reviewer (true), or are accepted as the
# editor vouches for them and wait for the administrator's approval (false). Default: true.
BONEHUB_QC_EDITS_NEED_REVIEW=

# How long a user keeps a subject before it returns to the queue, in seconds.
# Default: 86400 (24 hours).
BONEHUB_QC_LEASE_TTL_SECONDS=

# How many subjects one user may hold at a time, in each role. Default: 1.
BONEHUB_QC_MAX_CONCURRENT_ASSIGNMENTS_PER_USER=
